---
const chromeStoreUrl = 'https://chromewebstore.google.com/detail/prompticon/niofgdlmoogjllonnpdhmajdginmcnke';
---

<section aria-labelledby="prompticon-title" class="mx-4 mt-2 shrink-0 rounded-md border border-[#222] bg-white/[0.01] p-3">
    <div class="mb-2 font-mono text-[11px] uppercase tracking-wide text-[#737373]">Browser pick</div>
    <div class="flex items-center gap-2.5">
        <img src="/images/prompticon.svg" alt="" width="34" height="34" loading="lazy" decoding="async" class="h-[34px] w-[34px] shrink-0 rounded-lg" />
        <div class="min-w-0">
            <h2 id="prompticon-title" class="m-0 text-[14px] font-semibold leading-tight text-white">Prompticon</h2>
            <p class="m-0 mt-0.5 text-[12px] leading-[1.4] text-[#a3a3a3]">One-click replies for your favorite AI chats.</p>
        </div>
    </div>
    <a href={chromeStoreUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1 font-mono text-[11px] text-[#a8e86f] no-underline transition-colors hover:text-[#c2ff8d] hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#a8e86f]">
        Add to Chrome
        <span aria-hidden="true">&rarr;</span>
    </a>
</section>
