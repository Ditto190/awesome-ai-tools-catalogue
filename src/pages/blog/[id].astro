---
import { getCollection, render } from 'astro:content';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { safeJsonForScript } from '../../lib/serialize';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => data.draft !== true);
  return blogEntries.map(entry => ({
    params: { id: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const postUrl = `https://ai.dosa.dev/blog/${entry.id}`;
const postImage = entry.data.image
  ? new URL(entry.data.image, 'https://ai.dosa.dev').href
  : 'https://ai.dosa.dev/images/og-image.png';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${postUrl}#article`,
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": postImage,
  "datePublished": entry.data.pubDate.toISOString(),
  "author": { "@type": "Person", "name": entry.data.author },
  "publisher": {
    "@type": "Organization",
    "@id": "https://ai.dosa.dev/#organization",
    "name": "dosa.dev",
    "url": "https://ai.dosa.dev",
    "logo": { "@type": "ImageObject", "url": "https://ai.dosa.dev/images/icons/favicon-96x96.png", "width": 96, "height": 96 }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
  "inLanguage": "en",
  ...(entry.data.tags?.length ? { "keywords": entry.data.tags.join(', ') } : {}),
});

// Table of contents: h2/h3 only
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Share links
const encodedUrl = encodeURIComponent(postUrl);
const encodedTitle = encodeURIComponent(entry.data.title);
const shareLinks = [
  {
    name: 'X',
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor" stroke="none"/>',
  },
  {
    name: 'LinkedIn',
    href: `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(`${entry.data.title}\n\n${postUrl}`)}`,
    icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.554V9h3.565v11.452z" fill="currentColor" stroke="none"/>',
  },
  {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="currentColor" stroke="none"/>',
  },
  {
    name: 'Reddit',
    href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
    icon: '<path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464-.029c-.688.687-2.284.769-2.532.769-.248 0-1.844-.082-2.532-.769a.327.327 0 0 0-.232-.065z" fill="currentColor" stroke="none"/>',
  },
];

// Deep links into AI chatbots with a pre-filled discussion prompt.
// The prompt is also copied to the clipboard on click as a fallback for
// targets that strip query params.
const aiPrompt = `I want to discuss this article: ${postUrl}`;
const aiTargets = [
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${encodeURIComponent(aiPrompt)}`, copiedLabel: 'Copied!' },
  { name: 'Claude', href: `https://claude.ai/new?q=${encodeURIComponent(aiPrompt)}`, copiedLabel: 'Copied!' },
  // Gemini doesn't reliably pre-fill from ?q= — the clipboard copy is the
  // primary path there, so say so in the feedback label.
  { name: 'Gemini', href: `https://gemini.google.com/app?q=${encodeURIComponent(aiPrompt)}`, copiedLabel: 'Copied — paste in Gemini' },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${encodeURIComponent(aiPrompt)}`, copiedLabel: 'Copied!' },
];

// Full article as markdown for the "Copy for LLM" action.
// The glob loader maps entry.id to a path under src/content/blog; guard the
// read so a missing/renamed file can't fail the whole SSG build.
let articleBody = '';
try {
  const mdxPath = join(process.cwd(), 'src', 'content', 'blog', `${entry.id}.mdx`);
  if (existsSync(mdxPath)) {
    articleBody = readFileSync(mdxPath, 'utf-8').replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, '').trim();
  } else {
    console.warn(`[blog] markdown source not found for entry "${entry.id}" (${mdxPath})`);
  }
} catch (err) {
  console.warn(`[blog] failed to read markdown for "${entry.id}":`, err);
}
const llmMarkdown = [
  `# ${entry.data.title}`,
  '',
  `> ${entry.data.description}`,
  '',
  `Source: ${postUrl}`,
  `Published: ${entry.data.pubDate.toISOString().slice(0, 10)}`,
  `Author: ${entry.data.author}`,
  '',
  '---',
  '',
  articleBody,
].join('\n');
const articleMarkdownJson = safeJsonForScript({ markdown: llmMarkdown });
---

<DashboardLayout
  title={`${entry.data.title} | ai.dosa.dev`}
  description={entry.data.description}
  canonical={postUrl}
  ogType="article"
  ogImage={postImage}
  jsonLd={jsonLd}
  activeNav="blog"
>
  <div class="max-w-[1400px] mx-auto w-full flex flex-col flex-1 min-h-full p-6 md:p-8">
    <div class="flex flex-col flex-1 w-full xl:grid xl:grid-cols-[1fr_minmax(0,48rem)_1fr] xl:gap-10">
      <div class="hidden xl:block"></div>

      <div class="max-w-3xl mx-auto xl:mx-0 flex flex-col flex-1 w-full min-w-0">
        <div class="mb-8">
          <a href="/blog" class="text-[#737373] hover:text-white transition-colors flex items-center text-sm font-mono tracking-wide w-fit">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Blog
          </a>
        </div>

        <article>
          <header class="mb-10 text-left">
            <h1 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight mb-4">
              {entry.data.title}
            </h1>
            <div class="flex flex-wrap items-center gap-3 text-sm text-[#737373] font-mono">
              <time datetime={entry.data.pubDate.toISOString()}>
                {entry.data.pubDate.toLocaleDateString('en-us', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <span>•</span>
              <span>{entry.data.author}</span>
              {remarkPluginFrontmatter && remarkPluginFrontmatter.readingTime && (
                  <>
                  <span>•</span>
                  <span>{remarkPluginFrontmatter.readingTime}</span>
                  </>
              )}
            </div>

            {/* Share row */}
            <div class="flex flex-wrap items-center gap-2 mt-6">
              <span class="text-xs font-mono uppercase tracking-widest text-[#525252] mr-1">Share</span>
              {shareLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Share on ${link.name}`}
                  title={`Share on ${link.name}`}
                  class="inline-flex items-center justify-center w-8 h-8 rounded-md border border-[#333] bg-white/[0.03] text-[#a3a3a3] hover:text-white hover:border-[#555] transition-colors"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" set:html={link.icon} />
                </a>
              ))}
              <button
                type="button"
                id="copy-link-btn"
                data-copy={postUrl}
                aria-label="Copy article link"
                title="Copy link"
                class="inline-flex items-center justify-center gap-1.5 h-8 px-2.5 rounded-md border border-[#333] bg-white/[0.03] text-[#a3a3a3] hover:text-white hover:border-[#555] transition-colors text-xs font-mono"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 0 0-5.656 0l-4 4a4 4 0 1 0 5.656 5.656l1.102-1.101m-.758-4.899a4 4 0 0 0 5.656 0l4-4a4 4 0 0 0-5.656-5.656l-1.1 1.1" />
                </svg>
                <span data-label>Copy link</span>
              </button>
            </div>

            {/* Discuss with AI row */}
            <div class="flex flex-wrap items-center gap-2 mt-3">
              <span class="text-xs font-mono uppercase tracking-widest text-[#525252] mr-1">Discuss with AI</span>
              {aiTargets.map((target) => (
                <a
                  href={target.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ai-copy-btn inline-flex items-center gap-1.5 h-8 px-2.5 rounded-md border border-[#333] bg-white/[0.03] text-[#a3a3a3] hover:text-white hover:border-[#555] transition-colors text-xs font-mono"
                  data-copy={aiPrompt}
                  data-copied-label={target.copiedLabel}
                  aria-label={`Discuss this article in ${target.name}`}
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                  <span data-label>{target.name}</span>
                </a>
              ))}
              <button
                type="button"
                id="copy-llm-btn"
                aria-label="Copy full article as markdown for an LLM"
                title="Copy full article as markdown"
                class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-md border border-[#333] bg-white/[0.03] text-[#a3a3a3] hover:text-white hover:border-[#555] transition-colors text-xs font-mono"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span data-label>Copy for LLM</span>
              </button>
            </div>

            {entry.data.tags && entry.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-6">
                {entry.data.tags.map((tag) => (
                  <span class="inline-flex items-center px-2 py-0.5 rounded border border-[#333] text-xs font-mono bg-white/[0.03] text-[#a3a3a3]">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </header>

          {/* Featured Image */}
          <div class="mb-12 rounded-xl overflow-hidden border border-[#222] bg-[#111] aspect-[21/9]">
            <img
              src={entry.data.image || '/images/blog-placeholder.png'}
              alt={entry.data.title}
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>

          <div id="article-body" class="prose prose-invert prose-zinc max-w-none prose-headings:font-semibold prose-a:text-[#22d3ee] hover:prose-a:text-[#67e8f9] prose-a:no-underline hover:prose-a:underline prose-code:text-[#a78bfa] prose-pre:bg-[#0a0a0a] prose-pre:border prose-pre:border-[#222] prose-img:rounded-lg prose-img:border prose-img:border-[#222] prose-hr:border-[#222]">
            <Content />
          </div>
        </article>

        <footer class="pt-12 pb-6 text-center border-t border-[#222] mt-auto">
          <span class="font-mono text-xs text-[#525252]">© {new Date().getFullYear()} dosa.dev</span>
        </footer>
      </div>

      {/* Table of contents (desktop) */}
      {tocHeadings.length > 0 && (
        <aside class="hidden xl:block">
          <nav aria-label="Table of contents" class="sticky top-8 border-l border-[#222] pl-4">
            <p class="text-xs font-mono uppercase tracking-widest text-[#525252] mb-3">On this page</p>
            <ul class="space-y-1 text-sm">
              {tocHeadings.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class:list={[
                      'toc-link block py-1 border-l-2 border-transparent -ml-[17px] pl-[15px] text-[#737373] hover:text-white transition-colors leading-snug',
                      { 'pl-[27px]': h.depth === 3 },
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </div>

  <!-- Full article markdown for the "Copy for LLM" action -->
  <script id="article-markdown" type="application/json" set:html={articleMarkdownJson} />

  <script src="/dist/blog.js" type="module" defer></script>
</DashboardLayout>
