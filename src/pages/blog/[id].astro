---
import { getCollection, render } from 'astro:content';
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { id: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);

const postUrl = `https://ai.dosa.dev/blog/${entry.id}`;
const postImage = entry.data.image
  ? new URL(entry.data.image, 'https://ai.dosa.dev').href
  : 'https://ai.dosa.dev/images/og-image.png';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${postUrl}#article`,
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": postImage,
  "datePublished": entry.data.pubDate.toISOString(),
  "author": { "@type": "Person", "name": entry.data.author },
  "publisher": {
    "@type": "Organization",
    "@id": "https://ai.dosa.dev/#organization",
    "name": "dosa.dev",
    "url": "https://ai.dosa.dev",
    "logo": { "@type": "ImageObject", "url": "https://ai.dosa.dev/images/icons/favicon-96x96.png", "width": 96, "height": 96 }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
  "inLanguage": "en",
  ...(entry.data.tags?.length ? { "keywords": entry.data.tags.join(', ') } : {}),
});
---

<DashboardLayout
  title={`${entry.data.title} | ai.dosa.dev`}
  description={entry.data.description}
  canonical={postUrl}
  ogType="article"
  ogImage={postImage}
  jsonLd={jsonLd}
  activeNav="blog"
>
  <div class="max-w-[1400px] mx-auto w-full flex flex-col flex-1 min-h-full p-6 md:p-8">
    <div class="max-w-3xl mx-auto flex flex-col flex-1 w-full">
      <div class="mb-8">
        <a href="/blog" class="text-[#737373] hover:text-white transition-colors flex items-center text-sm font-mono tracking-wide w-fit">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Blog
        </a>
      </div>

      <article>
        <header class="mb-10 text-left">
          <h1 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight mb-4">
            {entry.data.title}
          </h1>
          <div class="flex flex-wrap items-center gap-3 text-sm text-[#737373] font-mono">
            <time datetime={entry.data.pubDate.toISOString()}>
              {entry.data.pubDate.toLocaleDateString('en-us', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <span>•</span>
            <span>{entry.data.author}</span>
            {remarkPluginFrontmatter && remarkPluginFrontmatter.readingTime && (
                <>
                <span>•</span>
                <span>{remarkPluginFrontmatter.readingTime}</span>
                </>
            )}
          </div>
          {entry.data.tags && entry.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-6">
              {entry.data.tags.map((tag) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded border border-[#333] text-xs font-mono bg-white/[0.03] text-[#a3a3a3]">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        {/* Featured Image */}
        <div class="mb-12 rounded-xl overflow-hidden border border-[#222] bg-[#111] aspect-[21/9]">
          <img
            src={entry.data.image || '/images/blog-placeholder.png'}
            alt={entry.data.title}
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>

        <div class="prose prose-invert prose-zinc max-w-none prose-headings:font-semibold prose-a:text-[#22d3ee] hover:prose-a:text-[#67e8f9] prose-a:no-underline hover:prose-a:underline prose-code:text-[#a78bfa] prose-pre:bg-[#0a0a0a] prose-pre:border prose-pre:border-[#222] prose-img:rounded-lg prose-img:border prose-img:border-[#222] prose-hr:border-[#222]">
          <Content />
        </div>
      </article>
      
      <footer class="pt-12 pb-6 text-center border-t border-[#222] mt-auto">
        <span class="font-mono text-xs text-[#525252]">© {new Date().getFullYear()} dosa.dev</span>
      </footer>
    </div>
  </div>
</DashboardLayout>
